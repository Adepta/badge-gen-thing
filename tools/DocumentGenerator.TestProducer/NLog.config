<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration for DocumentGenerator.TestProducer
  ======================================================
  Targets:
    console  – colourised output (suppressed when running as a Windows/systemd service)
    file     – rolling JSON-lines log  (logs/producer-YYYY-MM-DD.log)
    otel     – OpenTelemetry log bridge (forwarded to the OTel SDK via NLog.Extensions.Logging)

  Structured logging notes:
    • All ${event-properties} are captured as key/value pairs in the JSON layout.
    • The OTel exporter is configured in Program.cs; NLog acts as the structured log source.
    • The "Microsoft.*" / "System.*" / "Rebus.*" namespaces are throttled to Warn.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Extensions.Logging" />
  </extensions>

  <!-- ======================================================================
       Shared JSON layout — emitted by the file target.
       Every structured log property added via logger.LogInformation(…, {Key}, value)
       is automatically captured by the ${all-event-properties} renderer.
       ====================================================================== -->
  <variable name="jsonLayout" value="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message:withexception=false}|${all-event-properties}|${exception:format=tostring}" />

  <targets async="true">

    <!-- ====================================================================
         Console target
         Colourised, human-readable.  Disabled at runtime when the host is
         detected as a Windows Service or systemd unit (no terminal attached).
         ==================================================================== -->
    <target xsi:type="ColoredConsole"
            name="console"
            useDefaultRowHighlightingRules="false"
            layout="${time} ${pad:padding=5:inner=${level:uppercase=true}} [${logger:shortName=true}] ${message}${onexception:inner= | ${exception:format=message}}${onhasproperties:inner= | ${all-event-properties}}">
      <highlight-row condition="level == LogLevel.Trace"   foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Debug"   foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Info"    foregroundColor="Cyan" />
      <highlight-row condition="level == LogLevel.Warn"    foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error"   foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal"   foregroundColor="White" backgroundColor="DarkRed" />
    </target>

    <!-- ====================================================================
         Rolling file target — JSON-lines (one JSON object per line)
         Rolls daily; keeps 30 days of archives; max 100 MB per file.
         ==================================================================== -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/producer-${shortdate}.log"
            archiveFileName="${basedir}/logs/archive/producer-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="30"
            archiveAboveSize="104857600"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="false">
      <layout xsi:type="JsonLayout" includeAllProperties="true" includeScopeProperties="true">
        <attribute name="timestamp"  layout="${longdate}" />
        <attribute name="level"      layout="${level:upperCase=true}" />
        <attribute name="logger"     layout="${logger}" />
        <attribute name="message"    layout="${message:withexception=false}" />
        <attribute name="exception"  layout="${exception:format=tostring}" />
        <attribute name="machineName" layout="${machineName}" />
        <attribute name="processId"  layout="${processid}" />
        <attribute name="threadId"   layout="${threadid}" />
        <attribute name="activityId" layout="${ActivityId}" />
      </layout>
    </target>

  </targets>

  <rules>
    <!-- Silence noisy infrastructure namespaces -->
    <logger name="Microsoft.*"       maxlevel="Info"  final="false" />
    <logger name="System.*"          maxlevel="Warn"  final="false" />
    <logger name="Rebus.*"           maxlevel="Warn"  final="false" />
    <logger name="Confluent.*"       maxlevel="Warn"  final="false" />

    <!-- Application loggers — Debug+ to all targets -->
    <logger name="DocumentGenerator.*" minlevel="Debug" writeTo="console,file" />

    <!-- Catch-all — Info+ -->
    <logger name="*"                   minlevel="Info"  writeTo="console,file" />
  </rules>

</nlog>
