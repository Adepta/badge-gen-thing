{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "DocumentGenerator — renders, errors, latency, logs and traces",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "Renders", "type": "row" },

    {
      "id": 1,
      "title": "Render rate (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(docgen_documentgenerator_render_count_total[1m])) by (document_type, success)",
          "legendFormat": "{{document_type}} success={{success}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Render latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(docgen_documentgenerator_render_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50", "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(docgen_documentgenerator_render_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95", "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(docgen_documentgenerator_render_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99", "refId": "C"
        }
      ]
    },

    {
      "id": 3,
      "title": "Error rate (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "reqpm",
          "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(docgen_documentgenerator_render_count_total{success=\"False\"}[1m]))",
          "legendFormat": "errors/min", "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Total renders",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(docgen_documentgenerator_render_count_total{success=\"True\"})",
          "legendFormat": "successful", "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Total errors",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(docgen_documentgenerator_render_count_total{success=\"False\"}) or vector(0)",
          "legendFormat": "errors", "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Avg render time",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 2000 },
          { "color": "red", "value": 5000 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(docgen_documentgenerator_render_duration_ms_sum[5m])) / sum(rate(docgen_documentgenerator_render_duration_ms_count[5m]))",
          "legendFormat": "avg ms", "refId": "A"
        }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 101, "title": "Traces", "type": "row" },

    {
      "id": 10,
      "title": "Recent traces — render.pipeline",
      "type": "traces",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "options": { "dedupStrategy": "none", "enableNodeGraph": true, "spanBar": { "type": "duration" } },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ name=\"render.pipeline\" }",
          "limit": 20,
          "refId": "A"
        }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102, "title": "Logs", "type": "row" },

    {
      "id": 20,
      "title": "All service logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\".+\"}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 21,
      "title": "Error logs only",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\".+\"} |= \"level=Error\" or {job=~\".+\"} |= \"\\\"level\\\":\\\"Error\\\"\" or {job=~\".+\"} |= \"fail:\"",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["docgen"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DocumentGenerator Overview",
  "uid": "docgen-overview",
  "version": 1
}
