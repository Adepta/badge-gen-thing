<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration for DocumentGenerator.Console (render service)
  =================================================================
  Targets:
    file   – rolling JSON-lines log  (logs/render-YYYY-MM-DD.log)
    otel   – OpenTelemetry log bridge via NLog.Extensions.Logging

  The Spectre TUI logger is a separate ILoggerProvider wired up in Program.cs.
  NLog does NOT write to stdout here — the TUI owns the terminal.

  Structured logging:
    All ${event-properties} are emitted as key/value pairs in the JSON layout,
    preserving named placeholders from ILogger calls (e.g. {CorrelationId}).
    The OTel bridge forwards every record into the OTel SDK pipeline.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Extensions.Logging" />
  </extensions>

  <targets async="true">

    <!-- ====================================================================
         Rolling file target — one JSON object per line (JSON-lines format).
         Rolls daily; keeps 30 days; max 100 MB per file.
         ==================================================================== -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/render-${shortdate}.log"
            archiveFileName="${basedir}/logs/archive/render-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="30"
            archiveAboveSize="104857600"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="false">
      <layout xsi:type="JsonLayout" includeAllProperties="true" includeScopeProperties="true">
        <attribute name="timestamp"   layout="${longdate}" />
        <attribute name="level"       layout="${level:upperCase=true}" />
        <attribute name="logger"      layout="${logger}" />
        <attribute name="message"     layout="${message:withexception=false}" />
        <attribute name="exception"   layout="${exception:format=tostring}" />
        <attribute name="machineName" layout="${machineName}" />
        <attribute name="processId"   layout="${processid}" />
        <attribute name="threadId"    layout="${threadid}" />
        <attribute name="activityId"  layout="${ActivityId}" />
      </layout>
    </target>

  </targets>

  <rules>
    <!-- Silence noisy infrastructure namespaces at file level -->
    <logger name="Microsoft.*"    maxlevel="Info"  final="false" />
    <logger name="System.*"       maxlevel="Warn"  final="false" />
    <logger name="Rebus.*"        maxlevel="Warn"  final="false" />
    <logger name="Confluent.*"    maxlevel="Warn"  final="false" />
    <logger name="PuppeteerSharp.*" maxlevel="Warn" final="false" />

    <!-- Own namespaces — Debug+ to file -->
    <logger name="DocumentGenerator.*" minlevel="Debug" writeTo="file" />

    <!-- Catch-all — Info+ to file -->
    <logger name="*"               minlevel="Info"  writeTo="file" />
  </rules>

</nlog>
