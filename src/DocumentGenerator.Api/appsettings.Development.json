{
  "Logging": {
    "LogLevel": {
      "Default":           "Debug",
      "DocumentGenerator": "Debug",
      "PuppeteerSharp":    "Information",
      "Microsoft":         "Information",
      "Rebus":             "Information",
      "Confluent.Kafka":   "Warning"
    }
  },

  "ApiAuth": {
    "ApiKey": "dev-api-key-insecure"
  },

  "Kafka": {
    "Enabled":              true,
    "BootstrapServers":     "localhost:9092",
    "RequestTopic":         "render.requests",
    "ResultTopic":          "render.results",
    "ResultTimeoutSeconds": 25
  }
}
