{
  "Logging": {
    "LogLevel": {
      "Default":                    "Information",
      "DocumentGenerator":          "Debug",
      "PuppeteerSharp":             "Warning",
      "Microsoft.AspNetCore":       "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  "Urls": "https://+:7070;http://+:7071",

  // ── API key authentication ─────────────────────────────────────────────────
  // Bridge clients must supply this value in the X-Api-Key header on every request.
  // REQUIRED: override in production via environment variable: ApiAuth__ApiKey
  // Never commit a real key to source control.
  "ApiAuth": {
    "ApiKey": "CHANGE-ME-IN-PRODUCTION"
  },

  // ── CORS ───────────────────────────────────────────────────────────────────
  // In production, replace * with the explicit origin(s) of your Bridge instances.
  // Example: "http://bridge.internal.yourdomain.com"
  // Comma-separate multiple origins.
  "Cors": {
    "AllowedOrigins": "*"
  },

  "BrowserPool": {
    "MinSize":               1,
    "MaxSize":               4,
    "AcquireTimeout":        "00:00:30",
    "IdleTimeout":           "00:05:00",
    "MaxRendersPerInstance": 100
  },

  "DocumentGenerator": {
    "TemplatesPath": "templates",
    "OutputPath":    "output"
  },

  // ── Kafka ──────────────────────────────────────────────────────────────────
  // When Enabled = true the API publishes render requests to Kafka and awaits
  // the result from render.results instead of rendering inline with Chromium.
  // Set Enabled = false to fall back to the direct in-process render path.
  "Kafka": {
    "Enabled":              false,
    "BootstrapServers":     "localhost:9092",
    "RequestTopic":         "render.requests",
    "ResultTopic":          "render.results",
    "DeadLetterTopic":      "render.deadletter",
    "ResultTimeoutSeconds": 25,
    "SecurityProtocol":     "Plaintext",
    "SaslMechanism":        null,
    "SaslUsername":         null,
    "SaslPassword":         null
  }
}
