@implements IDisposable

<div class="relative">
    @* Search icon *@
    <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-tertiary pointer-events-none"
         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>

    @* Search input *@
    <input type="text"
           @bind="_searchText"
           @bind:event="oninput"
           @bind:after="OnInputChanged"
           placeholder="Search templates..."
           class="w-full h-8 pl-8 pr-8 rounded-md text-[12px]
                  bg-bg-elevated border border-border-subtle
                  text-text-primary placeholder:text-text-tertiary
                  focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30
                  transition-colors" />

    @* Clear button *@
    @if (!string.IsNullOrEmpty(_searchText))
    {
        <button class="absolute right-2 top-1/2 -translate-y-1/2 p-0.5 rounded text-text-tertiary hover:text-text-primary transition-colors"
                @onclick="ClearSearch"
                title="Clear search">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>
    }
</div>

@code {
    private string _searchText = string.Empty;
    private Timer? _debounceTimer;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private void OnInputChanged()
    {
        // Debounce: wait 300ms after last keystroke before firing
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (OnSearch.HasDelegate)
                    await OnSearch.InvokeAsync(_searchText);
            });
        }, null, 300, Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        _searchText = string.Empty;
        _debounceTimer?.Dispose();
        if (OnSearch.HasDelegate)
            await OnSearch.InvokeAsync(string.Empty);
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
