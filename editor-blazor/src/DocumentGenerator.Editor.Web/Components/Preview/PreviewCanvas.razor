@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex-1 min-h-0 flex flex-col items-center overflow-auto py-6 px-4"
     style="background-image: radial-gradient(circle, var(--border-subtle) 1px, transparent 1px); background-size: 16px 16px;">

    @if (!string.IsNullOrEmpty(PreviewHtml))
    {
        @* Zoom container *@
        <div style="transform: scale(@ScaleFactor); transform-origin: top center; transition: transform 150ms ease;">
            @* Preview frame *@
            <iframe id="@_iframeId"
                    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                    style="width: @WidthPx; height: @HeightPx; border: 1px solid var(--border-default); border-radius: 4px; background: white; display: block;"
                    title="Template Preview">
            </iframe>
        </div>

        @* Dimension labels *@
        <div class="mt-3 text-[10px] text-text-tertiary font-mono tabular-nums flex-shrink-0">
            @($"{WidthMm:F1}") x @($"{HeightMm:F1}") mm &mdash; @Zoom%
        </div>
    }
    else
    {
        <div class="flex items-center justify-center h-full">
            <p class="text-text-tertiary text-[12px]">No preview available</p>
        </div>
    }
</div>

@code {
    private readonly string _iframeId = $"preview-iframe-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private string? _lastRenderedHtml;
    private const double MmToPixelFactor = 3.78; // 1mm ≈ 3.78px at 96 DPI

    /// <summary>
    /// The rendered HTML document to display in the iframe.
    /// </summary>
    [Parameter]
    public string? PreviewHtml { get; set; }

    /// <summary>
    /// Preview width in millimetres.
    /// </summary>
    [Parameter]
    public double WidthMm { get; set; } = 105;

    /// <summary>
    /// Preview height in millimetres.
    /// </summary>
    [Parameter]
    public double HeightMm { get; set; } = 148;

    /// <summary>
    /// Zoom percentage (e.g., 75 for 75%).
    /// </summary>
    [Parameter]
    public int Zoom { get; set; } = 75;

    private string WidthPx => $"{Math.Round(WidthMm * MmToPixelFactor)}px";
    private string HeightPx => $"{Math.Round(HeightMm * MmToPixelFactor)}px";
    private string ScaleFactor => $"{(Zoom / 100.0):F2}".Replace(',', '.');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/preview-interop.js");
        }

        // Render preview if HTML has changed
        if (_module is not null && PreviewHtml != _lastRenderedHtml)
        {
            _lastRenderedHtml = PreviewHtml;
            if (!string.IsNullOrEmpty(PreviewHtml))
            {
                await _module.InvokeVoidAsync("renderPreview", _iframeId, PreviewHtml);
            }
            else
            {
                await _module.InvokeVoidAsync("clearPreview", _iframeId);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("clearPreview", _iframeId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, nothing to clean up
            }
        }
    }
}
