@using DocumentGenerator.Editor.Web.Components.Shared

<Modal IsVisible="@IsVisible" Title="Rename Template" OnClose="HandleClose" MaxWidth="420px">
    <ChildContent>
        <div class="flex flex-col gap-4">
            @* Current name *@
            <div class="flex flex-col gap-1">
                <label class="text-[12px] font-medium text-text-secondary">Current Name</label>
                <p class="text-[13px] text-text-primary font-mono bg-bg-elevated px-3 py-2 rounded-md border border-border-subtle">
                    @CurrentName
                </p>
            </div>

            @* New name input *@
            <div class="flex flex-col gap-1.5">
                <label class="text-[12px] font-medium text-text-secondary">New Name</label>
                <input type="text"
                       @bind="_newName"
                       @bind:event="oninput"
                       @bind:after="ValidateName"
                       placeholder="Enter new name..."
                       class="h-9 px-3 rounded-md text-[13px]
                              bg-bg-elevated border border-border-subtle
                              text-text-primary placeholder:text-text-tertiary
                              focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30
                              transition-colors" />
                @if (!string.IsNullOrEmpty(_nameError))
                {
                    <p class="text-[11px] text-error">@_nameError</p>
                }
            </div>
        </div>
    </ChildContent>

    <FooterContent>
        <button class="px-4 py-2 rounded-md text-[12px] font-medium
                       text-text-secondary bg-bg-elevated border border-border-subtle
                       hover:bg-bg-base hover:text-text-primary transition-colors"
                @onclick="HandleClose">
            Cancel
        </button>
        <button class="px-4 py-2 rounded-md text-[12px] font-medium
                       bg-accent text-white hover:bg-accent-hover transition-colors
                       disabled:opacity-50 disabled:cursor-not-allowed"
                disabled="@(!IsNameValid)"
                @onclick="HandleRename">
            Rename
        </button>
    </FooterContent>
</Modal>

@code {
    private string _newName = string.Empty;
    private string? _nameError;

    private bool IsNameValid =>
        !string.IsNullOrWhiteSpace(_newName)
        && string.IsNullOrEmpty(_nameError)
        && _newName != CurrentName;

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string CurrentName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string> OnRenamed { get; set; }

    protected override void OnParametersSet()
    {
        if (IsVisible && string.IsNullOrEmpty(_newName))
        {
            _newName = CurrentName;
        }
    }

    private void ValidateName()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _nameError = "Name is required.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(_newName, @"^[a-zA-Z0-9\-]+$"))
        {
            _nameError = "Only letters, numbers, and hyphens are allowed.";
            return;
        }

        if (_newName == CurrentName)
        {
            _nameError = "New name must be different from the current name.";
            return;
        }

        _nameError = null;
    }

    private async Task HandleRename()
    {
        ValidateName();
        if (!IsNameValid) return;

        if (OnRenamed.HasDelegate)
            await OnRenamed.InvokeAsync(_newName);

        _newName = string.Empty;
        _nameError = null;
    }

    private async Task HandleClose()
    {
        _newName = string.Empty;
        _nameError = null;
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}
