@using DocumentGenerator.Editor.Core.Models

@if (IsVisible)
{
    @* Backdrop *@
    <div class="fixed inset-0 z-50 flex items-start justify-center pt-[15vh] animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-label="Command palette"
         @onclick="HandleBackdropClick"
         @onkeydown="HandleKeyDown"
         @onkeydown:preventDefault="@_preventDefault">

        @* Blur overlay *@
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

        @* Command palette card *@
        <div class="relative z-10 w-full rounded-xl border border-border-default bg-bg-overlay shadow-2xl overflow-hidden
                    animate-scale-in"
             style="max-width: 520px;"
             @onclick:stopPropagation="true">

            @* Search input *@
            <div class="flex items-center gap-3 px-4 py-3 border-b border-border-default">
                @* Search icon *@
                <svg class="w-4 h-4 text-text-tertiary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>

                <input @ref="_searchInput"
                       type="text"
                       class="flex-1 bg-transparent text-[14px] text-text-primary placeholder-text-tertiary outline-none"
                       placeholder="Type a command or search..."
                       @bind="_searchText"
                       @bind:event="oninput"
                       @bind:after="OnSearchChanged"
                       autocomplete="off"
                       spellcheck="false" />

                @* Ctrl+K badge *@
                <kbd class="text-[10px] font-mono text-text-tertiary bg-bg-elevated border border-border-subtle rounded px-1.5 py-0.5 flex-shrink-0">
                    Ctrl+K
                </kbd>
            </div>

            @* Results *@
            <div class="max-h-[400px] overflow-y-auto" @ref="_resultsContainer">
                @if (_filteredGroups.Count == 0)
                {
                    <div class="px-4 py-8 text-center text-[13px] text-text-tertiary">
                        No results found
                    </div>
                }
                else
                {
                    var globalIndex = 0;
                    var isFirstGroup = true;

                    @foreach (var group in _filteredGroups)
                    {
                        if (!isFirstGroup)
                        {
                            <div class="h-px bg-border-subtle"></div>
                        }
                        isFirstGroup = false;

                        @* Group header *@
                        <div class="text-[11px] font-medium text-text-tertiary uppercase tracking-wider px-4 py-1.5 bg-bg-surface">
                            @group.Name
                        </div>

                        @foreach (var item in group.Items)
                        {
                            var idx = globalIndex;
                            var isSelected = idx == _selectedIndex;

                            <button class="@GetItemClass(isSelected)"
                                    @onclick="@(() => ExecuteItem(item))"
                                    @onmouseenter="@(() => { _selectedIndex = idx; StateHasChanged(); })">
                                @* Icon *@
                                <span class="w-4 h-4 flex items-center justify-center flex-shrink-0 text-text-tertiary">
                                    @((MarkupString)item.Icon)
                                </span>

                                @* Label *@
                                <span class="flex-1 text-[13px] text-text-primary truncate text-left">
                                    @item.Label
                                </span>

                                @* Group badge *@
                                <span class="text-[11px] text-text-tertiary flex-shrink-0">
                                    @item.GroupBadge
                                </span>
                            </button>

                            globalIndex++;
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _searchInput;
    private ElementReference _resultsContainer;
    private string _searchText = string.Empty;
    private int _selectedIndex;
    private bool _preventDefault;
    private List<CommandGroup> _filteredGroups = new();
    private List<CommandItem> _flatItems = new();

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public List<string> RecentTemplates { get; set; } = new();

    [Parameter]
    public EventCallback<string> OnAction { get; set; }

    [Parameter]
    public bool HasTemplateOpen { get; set; }

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            _searchText = string.Empty;
            _selectedIndex = 0;
            BuildFilteredResults();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible)
        {
            try
            {
                await _searchInput.FocusAsync();
            }
            catch
            {
                // Element may not be rendered yet
            }
        }
    }

    private void OnSearchChanged()
    {
        _selectedIndex = 0;
        BuildFilteredResults();
    }

    private void BuildFilteredResults()
    {
        var allGroups = BuildAllGroups();
        var search = _searchText.Trim();

        _filteredGroups = new List<CommandGroup>();
        _flatItems = new List<CommandItem>();

        foreach (var group in allGroups)
        {
            List<CommandItem> matchingItems;

            if (string.IsNullOrEmpty(search))
            {
                matchingItems = group.Items.ToList();
            }
            else
            {
                matchingItems = group.Items
                    .Where(i => i.Label.Contains(search, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            if (matchingItems.Count > 0)
            {
                _filteredGroups.Add(new CommandGroup(group.Name, matchingItems));
                _flatItems.AddRange(matchingItems);
            }
        }
    }

    private List<CommandGroup> BuildAllGroups()
    {
        var groups = new List<CommandGroup>();

        // 1. Recent Templates
        if (RecentTemplates.Count > 0)
        {
            var recentItems = RecentTemplates.Select(name => new CommandItem(
                name,
                $"template:{name}",
                SvgIcons.File,
                "Recent"
            )).ToList();
            groups.Add(new CommandGroup("Recent Templates", recentItems));
        }

        // 2. Actions
        var actions = new List<CommandItem>
        {
            new("New Template", "new", SvgIcons.Plus, "Action"),
            new("Import", "import", SvgIcons.Upload, "Action"),
        };

        if (HasTemplateOpen)
        {
            actions.Insert(1, new("Save", "save", SvgIcons.Save, "Action"));
            actions.Insert(2, new("Duplicate", "duplicate", SvgIcons.Copy, "Action"));
            actions.Insert(3, new("Rename", "rename", SvgIcons.Edit, "Action"));
            actions.Insert(4, new("Delete", "delete", SvgIcons.Trash, "Action"));
            actions.Add(new("Export", "export", SvgIcons.Download, "Action"));
        }

        actions.Add(new("Upload Assets", "upload-assets", SvgIcons.Upload, "Action"));
        actions.Add(new("Toggle Theme", "toggle-theme", SvgIcons.SunMoon, "Action"));
        actions.Add(new("Open Settings", "settings", SvgIcons.Gear, "Action"));

        groups.Add(new CommandGroup("Actions", actions));

        // 3. Quick Parts (tokens only, not blocks)
        var quickParts = QuickPart.All
            .Where(qp => qp.Category == "Token")
            .Select(qp => new CommandItem(
                qp.Label,
                $"quickpart:{qp.InsertText}",
                SvgIcons.Code,
                qp.Group
            )).ToList();

        if (quickParts.Count > 0)
        {
            groups.Add(new CommandGroup("Quick Parts", quickParts));
        }

        // 4. Settings
        var settingsItems = new List<CommandItem>
        {
            new("Dark Mode", "theme-dark", SvgIcons.Moon, "Settings"),
            new("Light Mode", "theme-light", SvgIcons.Sun, "Settings"),
            new("System Theme", "theme-system", SvgIcons.Monitor, "Settings"),
        };
        groups.Add(new CommandGroup("Settings", settingsItems));

        return groups;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _preventDefault = true;
                await Close();
                _preventDefault = false;
                break;

            case "ArrowDown":
                _preventDefault = true;
                _selectedIndex = (_selectedIndex + 1) % Math.Max(1, _flatItems.Count);
                break;

            case "ArrowUp":
                _preventDefault = true;
                _selectedIndex = (_selectedIndex - 1 + _flatItems.Count) % Math.Max(1, _flatItems.Count);
                break;

            case "Enter":
                _preventDefault = true;
                if (_selectedIndex >= 0 && _selectedIndex < _flatItems.Count)
                {
                    await ExecuteItem(_flatItems[_selectedIndex]);
                }
                break;

            default:
                _preventDefault = false;
                break;
        }
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private async Task ExecuteItem(CommandItem item)
    {
        await Close();
        if (OnAction.HasDelegate)
        {
            await OnAction.InvokeAsync(item.Action);
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private string GetItemClass(bool isSelected) =>
        isSelected
            ? "w-full flex items-center gap-3 px-4 py-2.5 cursor-pointer bg-accent-muted border-l-2 border-accent transition-colors"
            : "w-full flex items-center gap-3 px-4 py-2.5 cursor-pointer hover:bg-bg-elevated border-l-2 border-transparent transition-colors";

    // -- Inner types --

    private record CommandGroup(string Name, List<CommandItem> Items);

    private record CommandItem(string Label, string Action, string Icon, string GroupBadge);

    // -- SVG Icons --

