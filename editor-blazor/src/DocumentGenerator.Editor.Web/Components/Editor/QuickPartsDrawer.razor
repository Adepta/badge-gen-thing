@using DocumentGenerator.Editor.Core.Models
@using DocumentGenerator.Editor.Web.Services
@inject MonacoInteropService MonacoInterop

<div class="absolute top-0 right-0 bottom-0 z-30 flex transition-transform duration-200 ease-out
            @(IsVisible ? "translate-x-0" : "translate-x-full")"
     style="width: 300px;"
     role="complementary"
     aria-label="Quick Parts drawer">
    <div class="flex flex-col w-full bg-bg-surface border-l border-border-default shadow-lg">
        @* Header *@
        <div class="flex items-center px-3 h-10 border-b border-border-subtle flex-shrink-0">
            <span class="text-[13px] font-semibold text-text-primary flex-1">Quick Parts</span>
            <button class="p-1 rounded-md text-text-tertiary hover:text-text-primary hover:bg-bg-elevated transition-colors focus-ring"
                    title="Close (Ctrl+Q)"
                    aria-label="Close Quick Parts drawer"
                    @onclick="HandleClose">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>

        @* Tab bar *@
        <div class="flex items-center bg-bg-base border-b border-border-subtle flex-shrink-0">
            <button class="@GetTabClass(_activeTab == "tokens")"
                    @onclick="@(() => _activeTab = "tokens")">
                Tokens
            </button>
            <button class="@GetTabClass(_activeTab == "blocks")"
                    @onclick="@(() => _activeTab = "blocks")">
                Blocks
            </button>
        </div>

        @* Content *@
        <div class="flex-1 overflow-y-auto min-h-0">
            @if (_activeTab == "tokens")
            {
                @* Tokens tab *@
                <div class="p-3 flex flex-col gap-3">
                    @foreach (var group in _tokenGroups)
                    {
                        <div>
                            <div class="text-[10px] font-semibold uppercase tracking-wider mb-1.5"
                                 style="color: @group.Color;">
                                @group.Name
                            </div>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var token in group.Tokens)
                                {
                                    <button class="px-2 py-1 rounded-md font-mono text-[11px] text-text-secondary
                                                   bg-bg-elevated border border-border-subtle
                                                   hover:bg-accent-muted hover:border-accent hover:text-text-primary
                                                   active:scale-[0.97] transition-all duration-150 cursor-pointer"
                                            title="@token.Description"
                                            @onclick="@(() => InsertToken(token))">
                                        @token.Label
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @* Blocks tab *@
                <div class="p-3 flex flex-col gap-2">
                    @foreach (var block in _blocks)
                    {
                        <button class="w-full text-left p-2.5 rounded-lg bg-bg-elevated border border-border-subtle
                                       hover:border-accent hover:bg-accent-muted transition-all duration-150 cursor-pointer group"
                                @onclick="@(() => InsertBlock(block))">
                            <div class="text-[12px] font-medium text-text-primary group-hover:text-accent transition-colors">
                                @block.Label
                            </div>
                            @if (!string.IsNullOrEmpty(block.Description))
                            {
                                <div class="text-[11px] text-text-tertiary mt-0.5">@block.Description</div>
                            }
                            <div class="font-mono text-[10px] text-text-tertiary mt-1 overflow-hidden leading-tight"
                                 style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                @TruncateSnippet(block.InsertText)
                            </div>
                            <div class="mt-1">
                                <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-medium uppercase tracking-wider
                                             @(block.TargetEditor == QuickPartTarget.Css ? "bg-blue-500/10 text-blue-400" : "bg-orange-500/10 text-orange-400")">
                                    @(block.TargetEditor == QuickPartTarget.Css ? "CSS" : "HTML")
                                </span>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _activeTab = "tokens";

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// The ID of the last focused Monaco editor ("editor-html" or "editor-css").
    /// Used to determine where tokens are inserted.
    /// </summary>
    [Parameter]
    public string LastFocusedEditorId { get; set; } = "editor-html";

    // Token groups organized by category
    private readonly List<TokenGroup> _tokenGroups;
    private readonly List<QuickPart> _blocks;

    public QuickPartsDrawer()
    {
        var allParts = QuickPart.All;

        _tokenGroups = new List<TokenGroup>
        {
            new("Attendee Variables", "#a78bfa",
                allParts.Where(p => p.Category == "Token" && p.Group == "Attendee").ToList()),
            new("Branding", "#2dd4bf",
                allParts.Where(p => p.Category == "Token" && p.Group == "Branding").ToList()),
            new("Helpers", "#fb923c",
                allParts.Where(p => p.Category == "Token" && p.Group == "Helpers").ToList()),
            new("CSS Branding Values", "#60a5fa",
                allParts.Where(p => p.Category == "Token" && p.Group == "CSS Branding").ToList()),
        };

        _blocks = allParts.Where(p => p.Category == "Block").ToList();
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task InsertToken(QuickPart token)
    {
        // CSS branding tokens go to CSS editor, all others to last focused
        var targetEditorId = token.TargetEditor == QuickPartTarget.Css
            ? "editor-css"
            : LastFocusedEditorId;

        try
        {
            await MonacoInterop.InsertTextAsync(targetEditorId, token.InsertText);
        }
        catch
        {
            // Editor may not be initialized
        }
    }

    private async Task InsertBlock(QuickPart block)
    {
        // HTML blocks -> html editor, CSS blocks -> css editor
        var targetEditorId = block.TargetEditor == QuickPartTarget.Css
            ? "editor-css"
            : "editor-html";

        try
        {
            await MonacoInterop.InsertTextAsync(targetEditorId, block.InsertText);
        }
        catch
        {
            // Editor may not be initialized
        }
    }

    private string TruncateSnippet(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        // Replace newlines with spaces for preview
        var flat = text.Replace("\n", " ").Replace("\r", "");
        return flat.Length > 120 ? flat[..120] + "..." : flat;
    }

    private string GetTabClass(bool isActive) =>
        isActive
            ? "flex-1 px-3 py-2 text-[12px] font-medium text-accent border-b-2 border-accent transition-colors"
            : "flex-1 px-3 py-2 text-[12px] font-medium text-text-tertiary hover:text-text-secondary border-b-2 border-transparent transition-colors";

    private record TokenGroup(string Name, string Color, List<QuickPart> Tokens);
}
