# ─────────────────────────────────────────────────────────────────────────────
# DocumentGenerator — environment variable overrides
#
# Copy this file to .env (already in .gitignore) and fill in real values.
# These variables are injected into the running processes at startup and
# override any values in appsettings.json.
#
# .NET configuration key separator: use __ (double underscore) for nested keys.
# e.g. ApiAuth__ApiKey maps to  { "ApiAuth": { "ApiKey": "..." } }
# ─────────────────────────────────────────────────────────────────────────────

# ── DocumentGenerator.Api ─────────────────────────────────────────────────────

# REQUIRED in production: the API key all Bridge clients must send in X-Api-Key.
# Must be a cryptographically random string (min 32 chars recommended).
# Generate one with:  openssl rand -hex 32
ApiAuth__ApiKey=CHANGE-ME-IN-PRODUCTION

# CORS: comma-separated list of allowed Bridge origins. Use * only in development.
# Example: Cors__AllowedOrigins=http://bridge.internal.example.com
Cors__AllowedOrigins=*

# Kafka connection (when Kafka:Enabled = true)
Kafka__Enabled=false
Kafka__BootstrapServers=localhost:9092
# For Confluent Cloud / MSK — set protocol, mechanism, username and password:
# Kafka__SecurityProtocol=SaslSsl
# Kafka__SaslMechanism=ScramSha256
# Kafka__SaslUsername=<your-api-key>
# Kafka__SaslPassword=<your-api-secret>

# ── DocumentGenerator.Console ─────────────────────────────────────────────────

# Kafka connection for the render worker (same broker as API when using Kafka mode)
# Kafka__BootstrapServers=localhost:9092
# Kafka__SecurityProtocol=SaslSsl
# Kafka__SaslMechanism=ScramSha256
# Kafka__SaslUsername=<your-api-key>
# Kafka__SaslPassword=<your-api-secret>

# ── DocumentGenerator.Bridge ──────────────────────────────────────────────────

# URL of the cloud-hosted API (no trailing slash)
Cloud__BaseUrl=https://api.yourdomain.com

# API key matching ApiAuth__ApiKey on the API side
Cloud__ApiKey=CHANGE-ME-IN-PRODUCTION

# Default printer name (leave blank to use OS default)
# Printer__DefaultPrinterName=HP LaserJet Pro
