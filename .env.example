# =============================================================================
# DocumentGenerator — environment variable overrides
#
# Copy this file to .env (already in .gitignore) and fill in real values.
# Variables here are loaded by Docker Compose and override appsettings.json.
#
# .NET config key separator: use __ (double underscore) for nested keys.
#   e.g.  ApiAuth__ApiKey  maps to  { "ApiAuth": { "ApiKey": "..." } }
# =============================================================================

# =============================================================================
# REQUIRED — must be set before running
# =============================================================================

# API key all Bridge clients must send in X-Api-Key.
# Use the same value for API_KEY on both the Api and Bridge services.
# Generate one with: openssl rand -hex 32
API_KEY=CHANGE-ME-IN-PRODUCTION

# =============================================================================
# Api — DocumentGenerator.Api
# =============================================================================

# CORS: comma-separated list of allowed Bridge origins. * = allow all (dev only).
CORS_ALLOWED_ORIGINS=*

# Rate limiting
RATE_LIMIT_RENDER=10
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Console — DocumentGenerator.Console (render worker)
# =============================================================================

# Chromium pool size — how many parallel renders the Console can handle.
BROWSER_POOL_MAX_SIZE=4
KAFKA_MAX_CONCURRENT_RENDERS=4

# =============================================================================
# Kafka (shared by Api and Console)
# =============================================================================

# Local / self-hosted Kafka — leave as-is when using docker-compose.full.yml
# (services connect via kafka:29092 inside the Docker network).
# Override KAFKA_BOOTSTRAP_SERVERS only if pointing at an external broker.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Confluent Cloud / MSK / TLS-secured broker — uncomment and fill in:
# KAFKA_SECURITY_PROTOCOL=SaslSsl
# KAFKA_SASL_MECHANISM=ScramSha256
# KAFKA_SASL_USERNAME=<api-key>
# KAFKA_SASL_PASSWORD=<api-secret>

# =============================================================================
# Bridge — DocumentGenerator.Bridge
# =============================================================================

# URL of the cloud-hosted Api (no trailing slash).
# When running docker-compose.full.yml this is set automatically to http://api:8080.
# Override here only when Bridge points at a remote/cloud Api.
# CLOUD_API_BASE_URL=https://api.yourdomain.com

# Default printer name — leave blank to use the OS default.
# PRINTER_DEFAULT_NAME=HP LaserJet Pro

# =============================================================================
# Observability (OTel Collector endpoint is set automatically in full compose)
# =============================================================================

# Set to false to disable OpenTelemetry in all services.
# OTEL_ENABLED=true
# OTEL_ENDPOINT=http://otel-collector:4317
