# DocumentGenerator — local dev environment
#
# Copy to .env to use:
#   cp .env.example .env
#
# The defaults below work out of the box for local development.
# Change API_KEY to a real secret before deploying to production.

API_KEY=dev-api-key-insecure

CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RENDER=10
RATE_LIMIT_WINDOW_SECONDS=60

BROWSER_POOL_MAX_SIZE=4
KAFKA_MAX_CONCURRENT_RENDERS=4

# Uncomment for Confluent Cloud / MSK / TLS Kafka:
# KAFKA_SECURITY_PROTOCOL=SaslSsl
# KAFKA_SASL_MECHANISM=ScramSha256
# KAFKA_SASL_USERNAME=<api-key>
# KAFKA_SASL_PASSWORD=<api-secret>
